#!/usr/bin/env bash
# mesh-hygiene: Cluster-wide workspace, $HOME, package-drift, and cache hygiene manager
# Usage:
#   mesh-hygiene status              # Audit $HOME stray files, APT package drift, worktrees, and cache sizes
#   mesh-hygiene clean               # Scrub stray files in $HOME, stale /tmp entries, and apt cache on all nodes
#   mesh-hygiene freeze-packages     # Record current apt-mark showmanual as /etc/ag-baseline-packages.list
#   mesh-hygiene reset-packages      # Autopurge any ad-hoc APT packages not in /etc/ag-baseline-packages.list
#   mesh-hygiene prune-caches        # Clear pip/npm/xdg caches and evict old ccache entries
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'
  exit 0
fi

MESH_NODES=()
MESH_CONFIG="${MESH_CONFIG:-${HOME}/.config/mesh/cluster.conf}"
if [ -f "$MESH_CONFIG" ]; then
  # shellcheck disable=SC1090
  source "$MESH_CONFIG"
fi

if [ "${#MESH_NODES[@]}" -eq 0 ]; then
  echo "Error: No nodes configured. Run bootstrap-mesh.sh or create ${MESH_CONFIG}." >&2
  exit 1
fi

HOSTS=()
for entry in "${MESH_NODES[@]}"; do
  IFS="|" read -r _name _ip _mac _numa _persona _desc <<< "$entry"
  HOSTS+=("$_name")
done

ALLOWED_HOME_REGEX='^(\.antigravity-hub-server|\.bash_history|\.bash_logout|\.bash_profile|\.bashrc|\.cache|\.cargo|\.config|\.docker|\.gemini|\.gitconfig|\.gnupg|\.kube|\.lesshst|\.local|\.npm|\.profile|\.rustup|\.ssh|\.sudo_as_admin_successful|\.tmux\.conf|\.venv|\.vimrc|\.wget-hsts|\.zprofile|\.zshrc|Desktop|Documents|Downloads|Music|Pictures|Public|Templates|Videos|snap|tools)$'

POWER_BIN=""
if command -v mesh-power >/dev/null 2>&1; then
  POWER_BIN="$(command -v mesh-power)"
elif [ -x "${SCRIPT_DIR}/mesh-power" ]; then
  POWER_BIN="${SCRIPT_DIR}/mesh-power"
elif [ -x /usr/local/bin/mesh-power ]; then
  POWER_BIN="/usr/local/bin/mesh-power"
fi
if [ -n "$POWER_BIN" ]; then
  "$POWER_BIN" ensure
fi

SYNC_BIN=""
if command -v mesh-sync >/dev/null 2>&1; then
  SYNC_BIN="$(command -v mesh-sync)"
elif [ -x "${SCRIPT_DIR}/mesh-sync" ]; then
  SYNC_BIN="${SCRIPT_DIR}/mesh-sync"
elif [ -x /usr/local/bin/mesh-sync ]; then
  SYNC_BIN="/usr/local/bin/mesh-sync"
fi

for h in "${HOSTS[@]}"; do
  ssh -n -T "$h" "[ -w /run/ag-idle-minutes ] && echo 0 > /run/ag-idle-minutes 2>/dev/null || true" &
done
wait

cmd="${1:-status}"

case "$cmd" in
  status)
    echo "======================================================================"
    echo "=== 1. Active Project Worktrees (/opt/mesh) ==="
    echo "======================================================================"
    if [ -n "$SYNC_BIN" ]; then
      "$SYNC_BIN" list
    fi

    for host in "${HOSTS[@]}"; do
      echo ""
      echo "======================================================================"
      echo "=== 2. Node Hygiene Audit: ${host} ==="
      echo "======================================================================"
      ssh -n -T "$host" "
        set -euo pipefail
        USER_NAME=\$(id -un)
        USER_HOME=\"\$HOME\"

        echo '--- Disk Free (/ and /opt/mesh) ---'
        df -h / /opt/mesh | awk 'NR==1 || NR>1 {printf \"  %-34s %6s / %6s (%4s used) -> %s\n\", \$1, \$3, \$2, \$5, \$6}'

        echo '--- Shared SSD Caches & Tools (/opt/mesh/{cache,tools}) ---'
        du -sh /opt/mesh/cache/* /opt/mesh/tools/* 2>/dev/null | awk '{printf \"  %-8s %s\n\", \$1, \$2}' || true

        echo \"--- Stray Files in \${USER_HOME} (should be NONE) ---\"
        stray=\$(ls -A \"\$USER_HOME\" | grep -Ev '${ALLOWED_HOME_REGEX}' || true)
        if [ -z \"\$stray\" ]; then
          echo \"  [OK] \${USER_HOME} is 100% clean (only allowed dotfiles + tools -> /opt/mesh/tools).\"
        else
          printf '%s\n' \"\$stray\" | while IFS= read -r item; do
            [ -z \"\$item\" ] && continue
            du -sh \"\${USER_HOME}/\$item\" 2>/dev/null | awk '{printf \"  [STRAY] %-8s %s\n\", \$1, \$2}'
          done
        fi

        echo '--- Package Drift vs /etc/ag-baseline-packages.list ---'
        if [ -f /etc/ag-baseline-packages.list ]; then
          extra=\$(LC_ALL=C comm -13 <(LC_ALL=C sort /etc/ag-baseline-packages.list) <(apt-mark showmanual | LC_ALL=C sort) || true)
          missing=\$(LC_ALL=C comm -23 <(LC_ALL=C sort /etc/ag-baseline-packages.list) <(apt-mark showmanual | LC_ALL=C sort) || true)
          if [ -z \"\$extra\" ] && [ -z \"\$missing\" ]; then
            echo \"  [OK] 0 package drift (\$(wc -l < /etc/ag-baseline-packages.list) baseline packages).\"
          else
            [ -n \"\$extra\" ] && echo \"  [EXTRA]   \$(echo \$extra | tr '\n' ' ')\"
            [ -n \"\$missing\" ] && echo \"  [MISSING] \$(echo \$missing | tr '\n' ' ')\"
          fi
        else
          echo '  [WARN] /etc/ag-baseline-packages.list not initialized yet (run: mesh-hygiene freeze-packages).'
        fi
      "
    done

    if [ "${#HOSTS[@]}" -ge 2 ]; then
      echo ""
      echo "======================================================================"
      echo "=== 3. Cross-Node Package Parity (vs ${HOSTS[0]}) ==="
      echo "======================================================================"
      base_host="${HOSTS[0]}"
      base_pkgs=$(ssh -n -T "$base_host" "apt-mark showmanual | LC_ALL=C sort")
      for idx in "${!HOSTS[@]}"; do
        [ "$idx" -eq 0 ] && continue
        peer="${HOSTS[$idx]}"
        diff_out=$(diff -u <(printf '%s\n' "$base_pkgs") <(ssh -n -T "$peer" "apt-mark showmanual | LC_ALL=C sort") || true)
        if [ -z "$diff_out" ]; then
          echo "  [OK] ${base_host} and ${peer} have 100% identical manual APT package sets."
        else
          echo "  [DIFF] ${base_host} vs ${peer}:"
          echo "$diff_out"
        fi
      done
    fi
    ;;

  clean)
    for host in "${HOSTS[@]}"; do
      echo "=== Cleaning stray \$HOME files, stale /tmp entries, and APT cache on ${host} ==="
      ssh -n -T "$host" "
        set -euo pipefail
        USER_NAME=\$(id -un)
        USER_HOME=\"\$HOME\"
        mkdir -p /opt/mesh/cache/{ccache,buildroot-dl,cargo,npm,pip,xdg-cache} /opt/mesh/tools

        # Relocate ~/.cache and ~/.npm to /opt/mesh/cache if they are real directories
        for pair in '.cache:xdg-cache' '.npm:npm'; do
          dot=\${pair%%:*}
          target=/opt/mesh/cache/\${pair##*:}
          if [ -d \"\${USER_HOME}/\$dot\" ] && [ ! -L \"\${USER_HOME}/\$dot\" ]; then
            cp -a \"\${USER_HOME}/\$dot/.\" \"\$target/\" 2>/dev/null || true
            rm -rf \"\${USER_HOME}/\$dot\"
          fi
          ln -sfn \"\$target\" \"\${USER_HOME}/\$dot\"
        done
        ln -sfn /opt/mesh/tools \"\${USER_HOME}/tools\"
        sudo chown -R \"\${USER_NAME}:\${USER_NAME}\" /opt/mesh/cache /opt/mesh/tools \"\${USER_HOME}\"

        # Remove any stray files/folders in \$HOME outside the allowed set
        while IFS= read -r item; do
          [ -z \"\$item\" ] && continue
          echo \"  Removing stray: \${USER_HOME}/\$item\"
          rm -rf \"\${USER_HOME}/\$item\"
        done < <(ls -A \"\$USER_HOME\" | grep -Ev '${ALLOWED_HOME_REGEX}' || true)

        # Clean stale (>60m) non-session temporary files in /tmp, crash logs, and ambiguous HEAD refs
        find /tmp -mindepth 1 -maxdepth 1 -mmin +60 \
          ! -name 'systemd-private-*' ! -name 'pulse-*' ! -name '.X*' ! -name '.ICE*' ! -name '.font*' \
          ! -name 'snap-private-tmp' ! -name 'ssh-*' ! -name 'tmux-*' ! -name 'screen-*' \
          -exec rm -rf {} + 2>/dev/null || true
        rm -rf \"\${USER_HOME}/.gemini/antigravity-cli/crashes/\"* 2>/dev/null || true
        for r in /opt/mesh/repos/*.git; do
          [ -d \"\$r\" ] && git -C \"\$r\" update-ref -d refs/heads/HEAD 2>/dev/null || true
        done

        sudo DEBIAN_FRONTEND=noninteractive apt-get autoremove -y --purge >/dev/null
        sudo apt-get clean
      "
    done
    echo "Clean complete."
    ;;

  freeze-packages)
    for host in "${HOSTS[@]}"; do
      ssh -n -T "$host" "apt-mark showmanual | LC_ALL=C sort | sudo tee /etc/ag-baseline-packages.list >/dev/null && sudo chmod 0644 /etc/ag-baseline-packages.list"
      echo "[${host}] Saved $(ssh -n -T "$host" "wc -l < /etc/ag-baseline-packages.list") packages to /etc/ag-baseline-packages.list"
    done
    ;;

  reset-packages)
    for host in "${HOSTS[@]}"; do
      echo "=== Resetting ad-hoc APT packages on ${host} to /etc/ag-baseline-packages.list ==="
      ssh -n -T "$host" '
        set -euo pipefail
        if [ ! -f /etc/ag-baseline-packages.list ]; then
          echo "No /etc/ag-baseline-packages.list found on $(hostname); skipping."
          exit 0
        fi
        extra=$(LC_ALL=C comm -13 <(LC_ALL=C sort /etc/ag-baseline-packages.list) <(apt-mark showmanual | LC_ALL=C sort) || true)
        if [ -z "$extra" ]; then
          echo "  [OK] No extra packages to purge on $(hostname)."
        else
          echo "  Purging extra packages: $(echo "$extra" | tr "\n" " ")"
          printf "%s\n" "$extra" | xargs -r sudo DEBIAN_FRONTEND=noninteractive apt-get purge -y
          sudo DEBIAN_FRONTEND=noninteractive apt-get autoremove -y --purge
          sudo apt-get clean
        fi
      '
    done
    ;;

  prune-caches)
    for host in "${HOSTS[@]}"; do
      echo "=== Pruning caches on ${host} ==="
      ssh -n -T "$host" "
        CCACHE_DIR=/opt/mesh/cache/ccache ccache -c >/dev/null 2>&1 || true
        rm -rf /opt/mesh/cache/pip/* /opt/mesh/cache/npm/* /opt/mesh/cache/xdg-cache/* 2>/dev/null || true
        df -h /opt/mesh
      "
    done
    ;;

  *)
    echo "Usage: mesh-hygiene {status|clean|freeze-packages|reset-packages|prune-caches}" >&2
    exit 1
    ;;
esac
