#!/usr/bin/env bash
# mesh-power: Cluster Wake-on-LAN, S5 sleep, readiness check, and chassis TTS controller
# Usage: mesh-power <status|wake|sleep|ensure|notify|say> [args...]
set -euo pipefail

MESH_CONFIG="${MESH_CONFIG:-${HOME}/.config/mesh/cluster.conf}"
if [ -f "$MESH_CONFIG" ]; then
  # shellcheck disable=SC1090
  source "$MESH_CONFIG"
fi

MESH_BCAST="${MESH_BCAST:-192.168.1.255}"
MESH_IDLE_MINUTES="${MESH_IDLE_MINUTES:-30}"
if [ "${#MESH_NODES[@]}" -eq 0 ] 2>/dev/null; then
  echo "Error: No nodes configured. Run bootstrap-mesh.sh or create ${MESH_CONFIG}." >&2
  exit 1
fi

NODE_NAMES=()
NODE_IPS=()
NODE_MACS=()
for entry in "${MESH_NODES[@]}"; do
  IFS="|" read -r _name _ip _mac _numa _persona _desc <<< "$entry"
  NODE_NAMES+=("$_name")
  NODE_IPS+=("$_ip")
  NODE_MACS+=("$_mac")
done

all_online() {
  for ip in "${NODE_IPS[@]}"; do
    ping -c 1 -W 1 "$ip" >/dev/null 2>&1 || return 1
  done
  return 0
}

case "${1:-status}" in
  wake)
    echo "Sending Wake-on-LAN Magic Packets (${NODE_NAMES[*]})..."
    valid_macs=()
    for mac in "${NODE_MACS[@]}"; do
      if [ -n "$mac" ] && [ "$mac" != "00:00:00:00:00:00" ]; then
        valid_macs+=("$mac")
      fi
    done
    if [ "${#valid_macs[@]}" -eq 0 ]; then
      echo "Error: No valid MAC addresses configured in ${MESH_CONFIG}." >&2
      exit 1
    fi
    if command -v wakeonlan >/dev/null 2>&1; then
      wakeonlan -i "$MESH_BCAST" "${valid_macs[@]}"
    fi
    if grep -qi microsoft /proc/version 2>/dev/null && command -v powershell.exe >/dev/null 2>&1; then
      mac_csv=$(printf '"%s",' "${valid_macs[@]}")
      mac_csv="${mac_csv%,}"
      powershell.exe -NoProfile -Command "
        \$u = [System.Net.Sockets.UdpClient]::new()
        \$u.EnableBroadcast = \$true
        foreach (\$m in @(${mac_csv})) {
          \$b = [byte[]](,0xFF * 6 + (\$m.Split(':') | ForEach-Object { [Convert]::ToByte(\$_, 16) }) * 16)
          [void]\$u.Send(\$b, \$b.Length, '${MESH_BCAST}', 9)
        }
        \$u.Close()
      " >/dev/null 2>&1 || true
    fi
    ;;
  sleep)
    CALLER="${AG_CALLER:-$(whoami)}"
    echo "Powering down cluster nodes (${NODE_NAMES[*]}) into S5 WoL standby..."
    for name in "${NODE_NAMES[@]}"; do
      (
        ssh -o ConnectTimeout=3 "$name" "AG_CALLER=$(printf '%q' "$CALLER") /usr/local/bin/ag-notify offline 2>/dev/null || true; sudo poweroff" 2>/dev/null || true
        ssh -O exit "$name" 2>/dev/null || true
      ) &
    done
    wait
    echo "Shutdown signal dispatched."
    ;;
  notify|say)
    ACTION_KIND="${1}"
    CALLER="${AG_CALLER:-$(whoami)}"
    shift || true
    if [ "$ACTION_KIND" = "say" ]; then
      ARGS=(say "$*")
    else
      ARGS=("$@")
    fi
    REMOTE_ARGS=$(printf '%q ' "${ARGS[@]}")
    for name in "${NODE_NAMES[@]}"; do
      ssh -o ConnectTimeout=2 "$name" "if [ -x /usr/local/bin/ag-notify ]; then AG_CALLER=$(printf '%q' "$CALLER") /usr/local/bin/ag-notify ${REMOTE_ARGS}; fi" 2>/dev/null &
    done
    wait
    ;;
  status)
    for idx in "${!NODE_NAMES[@]}"; do
      name="${NODE_NAMES[$idx]}"
      ip="${NODE_IPS[$idx]}"
      mac="${NODE_MACS[$idx]}"
      if ping -c 1 -W 1 "$ip" >/dev/null 2>&1; then
        load=$(ssh -o ConnectTimeout=2 "$name" "printf '%s | Idle: %sm/${MESH_IDLE_MINUTES}m' \"\$(cut -d' ' -f1-3 /proc/loadavg)\" \"\$(cat /run/ag-idle-minutes 2>/dev/null || echo 0)\"" 2>/dev/null || echo "booting...")
        printf "[%-10s] %-15s | MAC: %s | STATE: ONLINE  (Load: %s)\n" "$name" "$ip" "$mac" "$load"
      else
        printf "[%-10s] %-15s | MAC: %s | STATE: OFFLINE (S5 Standby)\n" "$name" "$ip" "$mac"
      fi
    done
    ;;
  ensure)
    if ! all_online; then
      echo "[mesh-power] One or more cluster nodes offline. Triggering Wake-on-LAN..." >&2
      for name in "${NODE_NAMES[@]}"; do
        ssh -O exit "$name" 2>/dev/null || true
      done
      "$0" wake >&2
      echo -n "[mesh-power] Waiting for SSH readiness (${NODE_NAMES[*]})" >&2
      for _ in $(seq 1 60); do
        ready=1
        for name in "${NODE_NAMES[@]}"; do
          if ! ssh -o ConnectTimeout=2 "$name" "true" 2>/dev/null; then
            ready=0
            break
          fi
        done
        if [ "$ready" -eq 1 ]; then
          echo " ONLINE!" >&2
          exit 0
        fi
        echo -n "." >&2
        sleep 2
      done
      echo " TIMEOUT!" >&2
      exit 1
    fi
    ;;
  *)
    echo "Usage: mesh-power {status|wake|sleep|ensure|notify|say}"
    exit 1
    ;;
esac
