#!/usr/bin/env bash
# mesh-power: Cluster Wake-on-LAN, S5 sleep, readiness check, and chassis TTS controller
# Usage:
#   mesh-power status [host...]
#   mesh-power wake   [host...]
#   mesh-power sleep  [host...]
#   mesh-power ensure [host...]
#   mesh-power notify <online|offline|input|done> [message...]
#   mesh-power say    <message...>
set -euo pipefail

MESH_CONFIG="${MESH_CONFIG:-${HOME}/.config/mesh/cluster.conf}"
if [ -f "$MESH_CONFIG" ]; then
  # shellcheck disable=SC1090
  source "$MESH_CONFIG"
fi

MESH_BCAST="${MESH_BCAST:-192.168.1.255}"
MESH_IDLE_MINUTES="${MESH_IDLE_MINUTES:-30}"
if [ "${#MESH_NODES[@]}" -eq 0 ] 2>/dev/null; then
  echo "Error: No nodes configured. Run bootstrap-mesh.sh or create ${MESH_CONFIG}." >&2
  exit 1
fi

NODE_NAMES=()
NODE_IPS=()
NODE_MACS=()
for entry in "${MESH_NODES[@]}"; do
  IFS="|" read -r _name _ip _mac _numa _persona _desc <<< "$entry"
  NODE_NAMES+=("$_name")
  NODE_IPS+=("$_ip")
  NODE_MACS+=("$_mac")
done

resolve_indices() {
  local -n _out=$1
  shift
  _out=()
  if [ $# -eq 0 ]; then
    for idx in "${!NODE_NAMES[@]}"; do
      _out+=("$idx")
    done
    return 0
  fi
  for target in "$@"; do
    local found=0
    for idx in "${!NODE_NAMES[@]}"; do
      if [ "${NODE_NAMES[$idx]}" = "$target" ] || [ "${NODE_IPS[$idx]}" = "$target" ]; then
        _out+=("$idx")
        found=1
        break
      fi
    done
    if [ "$found" -eq 0 ]; then
      echo "Error: Unknown node '$target'. Configured nodes: ${NODE_NAMES[*]}" >&2
      return 1
    fi
  done
}

all_online() {
  local idx
  for idx in "$@"; do
    ping -c 1 -W 1 "${NODE_IPS[$idx]}" >/dev/null 2>&1 || return 1
  done
  return 0
}

ACTION="${1:-status}"
[ $# -gt 0 ] && shift

case "$ACTION" in
  wake)
    resolve_indices TARGET_INDICES "$@"
    target_names=()
    valid_macs=()
    for idx in "${TARGET_INDICES[@]}"; do
      target_names+=("${NODE_NAMES[$idx]}")
      mac="${NODE_MACS[$idx]}"
      if [ -n "$mac" ] && [ "$mac" != "00:00:00:00:00:00" ]; then
        valid_macs+=("$mac")
      fi
    done
    if [ "${#valid_macs[@]}" -eq 0 ]; then
      echo "Error: No valid MAC addresses configured for (${target_names[*]}) in ${MESH_CONFIG}." >&2
      exit 1
    fi
    echo "Sending Wake-on-LAN Magic Packets (${target_names[*]})..."
    if command -v wakeonlan >/dev/null 2>&1; then
      wakeonlan -i "$MESH_BCAST" "${valid_macs[@]}"
    fi
    if grep -qi microsoft /proc/version 2>/dev/null && command -v powershell.exe >/dev/null 2>&1; then
      mac_csv=$(printf '"%s",' "${valid_macs[@]}")
      mac_csv="${mac_csv%,}"
      powershell.exe -NoProfile -Command "
        \$u = [System.Net.Sockets.UdpClient]::new()
        \$u.EnableBroadcast = \$true
        foreach (\$m in @(${mac_csv})) {
          \$b = [byte[]](,0xFF * 6 + (\$m.Split(':') | ForEach-Object { [Convert]::ToByte(\$_, 16) }) * 16)
          [void]\$u.Send(\$b, \$b.Length, '${MESH_BCAST}', 9)
        }
        \$u.Close()
      " >/dev/null 2>&1 || true
    fi
    ;;

  sleep)
    resolve_indices TARGET_INDICES "$@"
    CALLER="${AG_CALLER:-$(whoami)}"
    target_names=()
    for idx in "${TARGET_INDICES[@]}"; do
      target_names+=("${NODE_NAMES[$idx]}")
    done
    echo "Powering down cluster nodes (${target_names[*]}) into S5 WoL standby..."
    for name in "${target_names[@]}"; do
      (
        ssh -n -o ConnectTimeout=3 "$name" "AG_CALLER=$(printf '%q' "$CALLER") /usr/local/bin/ag-notify offline 2>/dev/null || true; sudo poweroff" 2>/dev/null || true
        ssh -O exit "$name" 2>/dev/null || true
      ) &
    done
    wait
    echo "Shutdown signal dispatched."
    ;;

  notify|say)
    CALLER="${AG_CALLER:-$(whoami)}"
    if [ "$ACTION" = "say" ]; then
      ARGS=(say "$*")
    else
      ARGS=("$@")
    fi
    REMOTE_ARGS=$(printf '%q ' "${ARGS[@]}")
    for name in "${NODE_NAMES[@]}"; do
      ssh -n -o ConnectTimeout=2 "$name" "if [ -x /usr/local/bin/ag-notify ]; then AG_CALLER=$(printf '%q' "$CALLER") /usr/local/bin/ag-notify ${REMOTE_ARGS}; fi" 2>/dev/null &
    done
    wait
    ;;

  status)
    resolve_indices TARGET_INDICES "$@"
    for idx in "${TARGET_INDICES[@]}"; do
      name="${NODE_NAMES[$idx]}"
      ip="${NODE_IPS[$idx]}"
      mac="${NODE_MACS[$idx]}"
      if ping -c 1 -W 1 "$ip" >/dev/null 2>&1; then
        load=$(ssh -n -o ConnectTimeout=2 "$name" "printf '%s | Idle: %sm/${MESH_IDLE_MINUTES}m' \"\$(cut -d' ' -f1-3 /proc/loadavg)\" \"\$(cat /run/ag-idle-minutes 2>/dev/null || echo 0)\"" 2>/dev/null || echo "booting...")
        printf "[%-10s] %-15s | MAC: %s | STATE: ONLINE  (Load: %s)\n" "$name" "$ip" "$mac" "$load"
      else
        printf "[%-10s] %-15s | MAC: %s | STATE: OFFLINE (S5 Standby)\n" "$name" "$ip" "$mac"
      fi
    done
    ;;

  ensure)
    resolve_indices TARGET_INDICES "$@"
    if ! all_online "${TARGET_INDICES[@]}"; then
      target_names=()
      for idx in "${TARGET_INDICES[@]}"; do
        target_names+=("${NODE_NAMES[$idx]}")
        ssh -O exit "${NODE_NAMES[$idx]}" 2>/dev/null || true
      done
      echo "[mesh-power] Target node(s) offline (${target_names[*]}). Triggering Wake-on-LAN..." >&2
      "$0" wake "${target_names[@]}" >&2
      echo -n "[mesh-power] Waiting for SSH readiness (${target_names[*]})" >&2
      for _ in $(seq 1 60); do
        ready=1
        for name in "${target_names[@]}"; do
          if ! ssh -n -o ConnectTimeout=2 "$name" "true" 2>/dev/null; then
            ready=0
            break
          fi
        done
        if [ "$ready" -eq 1 ]; then
          echo " ONLINE!" >&2
          exit 0
        fi
        echo -n "." >&2
        sleep 2
      done
      echo " TIMEOUT!" >&2
      exit 1
    fi
    ;;

  *)
    echo "Usage: mesh-power {status|wake|sleep|ensure|notify|say} [args...]" >&2
    exit 1
    ;;
esac
