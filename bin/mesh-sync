#!/usr/bin/env bash
# mesh-sync: Project-agnostic Git bare-repo + NUMA worktree synchronizer
# Usage:
#   mesh-sync [push] [--keep-build] [--target <all|host|host-nodeN,...>] [--force]
#   mesh-sync status [--target <all|host|host-nodeN,...>]
#   mesh-sync fetch  [--target <all|host|host-nodeN,...>]
#   mesh-sync list   [--target <all|host,...>]
#   mesh-sync drop [project_name] [--target <all|host,...>]
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

ACTION="push"
PRESERVE_FLAG=""
FORCE_FLAG=""
TARGET_SPEC="all"
TARGET_PROJECT=""

while [ $# -gt 0 ]; do
  case "$1" in
    push|status|fetch|list) ACTION="$1" ;;
    drop|prune)
      ACTION="drop"
      if [ $# -gt 1 ] && [[ ! "$2" =~ ^- ]]; then
        TARGET_PROJECT="$2"
        shift
      fi
      ;;
    -t|--target)
      TARGET_SPEC="${2:?Missing value for $1}"
      shift
      ;;
    --target=*)
      TARGET_SPEC="${1#*=}"
      ;;
    -f|--force)
      FORCE_FLAG="--force"
      ;;
    --keep-build|--preserve-untracked)
      PRESERVE_FLAG="--preserve-untracked"
      ;;
    -h|--help)
      sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *)
      echo "Usage: mesh-sync [push|status|fetch|list|drop [project_name]] [--keep-build] [--target <spec>] [--force]" >&2
      exit 1
      ;;
  esac
  shift
done

create_working_snapshot() {
  if [ -z "$(git --no-optional-locks status --porcelain)" ]; then
    git rev-parse HEAD
    return 0
  fi

  local tmp_idx
  tmp_idx=$(mktemp /tmp/mesh-sync-index.XXXXXX)
  trap 'rm -f "${tmp_idx:-}" "${tmp_idx:-}.lock"' EXIT RETURN
  cp -p "$(git rev-parse --git-path index)" "$tmp_idx" 2>/dev/null || rm -f "$tmp_idx"
  GIT_INDEX_FILE="$tmp_idx" git add -A
  local tree_oid
  tree_oid=$(GIT_INDEX_FILE="$tmp_idx" git write-tree)

  local head_oid
  head_oid=$(git rev-parse HEAD)
  git commit-tree "$tree_oid" -p "$head_oid" -m "mesh-sync ephemeral working tree snapshot"
}

if [ "${MESH_SYNC_SOURCE_ONLY:-0}" = "1" ]; then
  return 0 2>/dev/null || exit 0
fi

MESH_NODES=()
MESH_CONFIG="${MESH_CONFIG:-${HOME}/.config/mesh/cluster.conf}"
if [ -f "$MESH_CONFIG" ]; then
  # shellcheck disable=SC1090
  source "$MESH_CONFIG"
fi

if [ "${#MESH_NODES[@]}" -eq 0 ]; then
  echo "Error: No nodes configured. Run bootstrap-mesh.sh or create ${MESH_CONFIG}." >&2
  exit 1
fi

NODE_NAMES=()
NODE_NUMAS=()
for entry in "${MESH_NODES[@]}"; do
  IFS="|" read -r _name _ip _mac _numa _persona _desc <<< "$entry"
  NODE_NAMES+=("$_name")
  NODE_NUMAS+=("${_numa:-2}")
done

TARGET_HOSTS=()
declare -A HOST_NODES_MAP=()
EXPLICIT_SOCKET_SPEC=0

add_host_socket() {
  local h="$1"
  local n="$2"
  local existing="${HOST_NODES_MAP[$h]:-}"
  if [ -z "$existing" ]; then
    TARGET_HOSTS+=("$h")
    HOST_NODES_MAP["$h"]="$n"
  elif [[ " $existing " != *" $n "* ]]; then
    HOST_NODES_MAP["$h"]="${existing} ${n}"
  fi
}

IFS="," read -r -a RAW_TARGET_PARTS <<< "$TARGET_SPEC"
for raw_part in "${RAW_TARGET_PARTS[@]}"; do
  part="${raw_part#"${raw_part%%[![:space:]]*}"}"
  part="${part%"${part##*[![:space:]]}"}"
  [ -z "$part" ] && continue

  if [ "$part" = "all" ]; then
    for idx in "${!NODE_NAMES[@]}"; do
      h="${NODE_NAMES[$idx]}"
      numas="${NODE_NUMAS[$idx]}"
      for ((n=0; n<numas; n++)); do
        add_host_socket "$h" "$n"
      done
    done
    continue
  fi

  matched=0
  for idx in "${!NODE_NAMES[@]}"; do
    if [ "${NODE_NAMES[$idx]}" = "$part" ]; then
      numas="${NODE_NUMAS[$idx]}"
      for ((n=0; n<numas; n++)); do
        add_host_socket "$part" "$n"
      done
      matched=1
      break
    fi
  done
  [ "$matched" -eq 1 ] && continue

  if [[ "$part" =~ ^(.+)-node([0-9]+)$ ]]; then
    cand_host="${BASH_REMATCH[1]}"
    cand_node="${BASH_REMATCH[2]}"
    for idx in "${!NODE_NAMES[@]}"; do
      if [ "${NODE_NAMES[$idx]}" = "$cand_host" ] && [ "$cand_node" -lt "${NODE_NUMAS[$idx]}" ]; then
        EXPLICIT_SOCKET_SPEC=1
        add_host_socket "$cand_host" "$cand_node"
        matched=1
        break
      fi
    done
  fi

  if [ "$matched" -eq 0 ]; then
    echo "Error: Unknown target '$part'. Configured hosts: ${NODE_NAMES[*]} (or <host>-node<N>, or 'all')." >&2
    exit 1
  fi
done

if [ "${#TARGET_HOSTS[@]}" -eq 0 ]; then
  echo "Error: No valid targets resolved from '$TARGET_SPEC'." >&2
  exit 1
fi

if [ "$ACTION" = "drop" ] && [ "$EXPLICIT_SOCKET_SPEC" -eq 1 ]; then
  echo "Error: 'mesh-sync drop' removes the shared host bare repository (/opt/mesh/repos/<project>.git); specify a host alias or 'all' instead of socket target '$TARGET_SPEC'." >&2
  exit 1
fi

POWER_BIN=""
if command -v mesh-power >/dev/null 2>&1; then
  POWER_BIN="$(command -v mesh-power)"
elif [ -x "${SCRIPT_DIR}/mesh-power" ]; then
  POWER_BIN="${SCRIPT_DIR}/mesh-power"
elif [ -x /usr/local/bin/mesh-power ]; then
  POWER_BIN="/usr/local/bin/mesh-power"
fi
if [ -n "$POWER_BIN" ]; then
  "$POWER_BIN" ensure "${TARGET_HOSTS[@]}"
fi

if [ "$ACTION" = "list" ]; then
  for host in "${TARGET_HOSTS[@]}"; do
    echo "=== [ $host (/opt/mesh) ] ==="
    ssh -n -T "$host" '
      for repo in /opt/mesh/repos/*.git; do
        [ -e "$repo" ] || { echo "  (no projects on cluster)"; break; }
        p=$(basename "$repo" .git)
        sz=$(du -sh "$repo" /opt/mesh/workspaces/node*/"$p" 2>/dev/null | awk "{printf \"%s \", \$1}")
        printf "  - %-28s (sizes: %s)\n" "$p" "$sz"
      done
    '
  done
  exit 0
fi

if [ -n "$TARGET_PROJECT" ]; then
  PROJECT="$(basename "$TARGET_PROJECT" .git)"
else
  TOPLEVEL=$(git rev-parse --show-toplevel 2>/dev/null || { echo "Error: Not inside a Git repository. Pass project name explicitly: mesh-sync drop <project_name>" >&2; exit 1; })
  PROJECT=$(basename "$TOPLEVEL")
  cd "$TOPLEVEL"
fi

if [[ -z "$PROJECT" || "$PROJECT" = "." || "$PROJECT" = ".." || "$PROJECT" =~ [/[:space:]\$\`\'\"\\] ]]; then
  echo "Error: Invalid project name '$PROJECT'" >&2
  exit 1
fi

wait_all() {
  local rc=0
  for pid in "$@"; do
    wait "$pid" || rc=1
  done
  return "$rc"
}

case "$ACTION" in
  push)
    if ! git rev-parse --verify HEAD >/dev/null 2>&1; then
      echo "Error: Repository '$PROJECT' has no commits yet. Make an initial commit first." >&2
      exit 1
    fi

    HEAD_REV=$(git rev-parse HEAD)
    SYNC_REV=$(create_working_snapshot)
    if [ "$SYNC_REV" = "$HEAD_REV" ]; then
      STATE_LABEL="clean-HEAD ($(git rev-parse --short "$SYNC_REV"))"
    else
      STATE_LABEL="dirty+untracked-snapshot ($(git rev-parse --short "$SYNC_REV"))"
    fi

    echo "Syncing project '$PROJECT' [$STATE_LABEL] across target NUMA worktrees (${TARGET_SPEC})..."
    pids=()
    for host in "${TARGET_HOSTS[@]}"; do
      host_nodes_csv="${HOST_NODES_MAP[$host]// /,}"
      (
        ssh -n -T "$host" "[ -w /run/ag-idle-minutes ] && echo 0 > /run/ag-idle-minutes 2>/dev/null || true; mkdir -p '/opt/mesh/repos/${PROJECT}.git' && [ -d '/opt/mesh/repos/${PROJECT}.git/objects' ] || git init --bare --initial-branch=main '/opt/mesh/repos/${PROJECT}.git' >/dev/null"
        git push --quiet --force "ssh://${host}/opt/mesh/repos/${PROJECT}.git" "${SYNC_REV}:refs/heads/mesh-sync"
        ssh -n -T "$host" "/usr/local/bin/ag-mesh-worktree '$PROJECT' refs/heads/mesh-sync --nodes '${host_nodes_csv}' $PRESERVE_FLAG $FORCE_FLAG"
      ) &
      pids+=("$!")
    done
    wait_all "${pids[@]}"
    ;;

  status)
    pids=()
    for host in "${TARGET_HOSTS[@]}"; do
      for node in ${HOST_NODES_MAP[$host]}; do
        ssh -n -T "$host" "
          WT='/opt/mesh/workspaces/node${node}/${PROJECT}'
          if git -C \"\$WT\" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
            REV=\$(git -C \"\$WT\" rev-parse --short HEAD 2>/dev/null || echo 'none')
            BR=\$(git -C \"\$WT\" symbolic-ref --short HEAD 2>/dev/null || echo 'detached')
            DIRTY=\$(git -C \"\$WT\" status --porcelain 2>/dev/null | wc -l)
            printf '[%-10s | node%s] %-22s | rev: %s | modified/untracked: %s\n' '$host' '$node' \"\$BR\" \"\$REV\" \"\$DIRTY\"
          else
            printf '[%-10s | node%s] NOT INITIALIZED (%s)\n' '$host' '$node' \"\$WT\"
          fi
        " &
        pids+=("$!")
      done
    done
    wait_all "${pids[@]}"
    ;;

  fetch)
    echo "Fetching remote subagent branches for '$PROJECT' (${TARGET_SPEC})..."
    for host in "${TARGET_HOSTS[@]}"; do
      for node in ${HOST_NODES_MAP[$host]}; do
        if git fetch --quiet --force "ssh://${host}/opt/mesh/repos/${PROJECT}.git" \
          "refs/heads/mesh/${host}-node${node}:refs/remotes/mesh/${host}-node${node}" 2>/dev/null; then
          REV=$(git rev-parse --short "refs/remotes/mesh/${host}-node${node}")
          printf "Fetched mesh/%s-node%s -> %s (diff with: git diff HEAD..mesh/%s-node%s)\n" \
            "$host" "$node" "$REV" "$host" "$node"
        else
          printf "Skipped mesh/%s-node%s (remote branch not yet initialized)\n" "$host" "$node"
        fi
      done
    done
    ;;

  drop)
    echo "Purging project '$PROJECT' from cluster nodes (${TARGET_HOSTS[*]})..."
    pids=()
    for host in "${TARGET_HOSTS[@]}"; do
      ssh -n -T "$host" "
        rm -rf /opt/mesh/workspaces/node*/'${PROJECT}' '/opt/mesh/repos/${PROJECT}.git'
        printf '[%-10s] Purged /opt/mesh/repos/%s.git and all node worktrees.\n' '$host' '$PROJECT'
      " &
      pids+=("$!")
    done
    wait_all "${pids[@]}"
    ;;
esac
